# Copy to terraform.tfvars and adjust. Everything has a default;
# region and ssh_ingress_cidr are the ones most worth setting.

region              = "us-east-1"
instance_type       = "t3.small"
app_port            = 3000
ssh_public_key_path = "~/.ssh/resolve.pub"

# Tighten SSH to your own IP (recommended):
# ssh_ingress_cidr = "203.0.113.7/32"
