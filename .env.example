# Copy to .env and adjust. All values below are the defaults — the stack
# runs without a .env file at all.

# Host port the app is published on by docker compose
APP_PORT=3000

# Host port the frontend is published on by docker compose
FRONTEND_PORT=5173

# Port the app listens on when run locally (go run ./cmd/api)
PORT=3000

# Postgres container credentials (docker compose)
POSTGRES_USER=resolve
POSTGRES_PASSWORD=resolve
POSTGRES_DB=resolve

# Connection string used when running the app locally against the
# compose-managed database (inside compose, the app derives its own URL)
DATABASE_URL=postgres://resolve:resolve@localhost:5432/resolve

# Anthropic API key the triage service uses to call Claude. Required for
# cmd/triage to start (it refuses to boot without it); leave unset if
# you're not running the triage service locally.
ANTHROPIC_API_KEY=

# Host port the triage service is published on by docker compose
TRIAGE_PORT=3001

# Port the triage service listens on when run locally (go run ./cmd/triage)
TRIAGE_SERVICE_URL=http://localhost:3001

# Where the triage service reaches the main app to write triage results
# back (POST /tickets/{id}/triage)
MAIN_APP_URL=http://localhost:3000
